---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import {
  ArrowRight,
  ArrowUpRight,
  BarChart3,
  Bath,
  Bed,
  Briefcase,
  Building,
  Building2,
  ChevronDown,
  Clock,
  Compass,
  ExternalLink,
  Home,
  Key,
  Mail,
  MapPin,
  Maximize2,
  Phone,
  PhoneCall,
  Search,
  ShieldCheck,
  Sparkles,
  Tag,
  Trees,
} from "@lucide/astro";
---

<Layout>
  <main>
    <Header />

    <!-- Hero Section -->
    <Hero />

    <section
      class="relative z-20 -mt-12 sm:-mt-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
    >
      <div
        class="bg-white rounded-2xl shadow-2xl p-4 sm:p-6 lg:p-8 border border-brand-sand/20"
      >
        <div
          class="flex flex-wrap items-center gap-2 border-b border-gray-100 pb-4 mb-6"
        >
          <button
            class="px-5 py-2.5 rounded-lg bg-brand-darkolive text-brand-cream font-medium text-sm sm:text-base transition-colors flex items-center gap-2"
          >
            <Tag class="w-4 h-4 text-brand-sand" />
            <span>Comprar</span>
          </button>
          <button
            class="px-5 py-2.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium text-sm sm:text-base transition-colors flex items-center gap-2"
          >
            <Key class="w-4 h-4" />
            <span>Alugar</span>
          </button>
          <button
            class="px-5 py-2.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium text-sm sm:text-base transition-colors flex items-center gap-2"
          >
            <Building class="w-4 h-4" />
            <span>Vender</span>
          </button>
        </div>

        <form
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 items-end"
          onsubmit="event.preventDefault()"
        >
          <div class="sm:col-span-2 lg:col-span-4 space-y-1.5">
            <label
              class="block text-xs font-semibold uppercase tracking-wider text-gray-500"
              >Localização ou Código</label
            >
            <div class="relative">
              <MapPin
                class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400"
              />
              <input
                type="text"
                placeholder="Onde? Ex: Bairro, Cidade ou ID"
                class="w-full pl-11 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-sand text-sm"
              />
            </div>
          </div>

          <div class="sm:col-span-1 lg:col-span-3 space-y-1.5">
            <label
              class="block text-xs font-semibold uppercase tracking-wider text-gray-500"
              >Tipo de Imóvel</label
            >
            <div class="relative">
              <Home
                class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400"
              />
              <select
                class="w-full pl-11 pr-8 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-sand text-sm appearance-none text-gray-700"
              >
                <option value="">Todos os tipos</option>
                <option>Casa Residencial</option>
                <option>Apartamento / Penthouse</option>
                <option>Sítio / Fazenda</option>
                <option>Comercial / Galpão</option>
              </select>
              <ChevronDown
                class="w-4 h-4 absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"
              />
            </div>
          </div>

          <div class="sm:col-span-1 lg:col-span-2 space-y-1.5">
            <label
              class="block text-xs font-semibold uppercase tracking-wider text-gray-500"
              >Dormitórios</label
            >
            <div class="relative">
              <Bed
                class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400"
              />
              <select
                class="w-full pl-11 pr-8 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-sand text-sm appearance-none text-gray-700"
              >
                <option value="">Qualquer</option>
                <option>1+ Quartos</option>
                <option>2+ Quartos</option>
                <option>3+ Quartos</option>
                <option>4+ Suítes</option>
              </select>
              <ChevronDown
                class="w-4 h-4 absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"
              />
            </div>
          </div>

          <div class="sm:col-span-2 lg:col-span-3">
            <button
              type="submit"
              class="w-full py-3.5 bg-brand-earth hover:bg-brand-darkolive text-white font-semibold rounded-xl transition-colors duration-300 shadow-md flex items-center justify-center gap-2"
            >
              <Search class="w-5 h-5" />
              <span>Buscar Imóveis</span>
            </button>
          </div>
        </form>
      </div>
    </section>

    <section class="py-16 sm:py-24 bg-brand-cream">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 bg-brand-darkolive text-brand-cream rounded-3xl p-6 sm:p-10 shadow-xl"
        >
          <div
            class="space-y-1 text-center sm:text-left border-r border-brand-sand/20 last:border-0 pr-2"
          >
            <div
              class="font-display text-3xl sm:text-5xl font-bold text-brand-sand"
            >
              15+
            </div>
            <div
              class="text-xs sm:text-sm text-brand-cream/70 uppercase tracking-wider"
            >
              Anos de Mercado
            </div>
          </div>

          <div
            class="space-y-1 text-center sm:text-left border-r border-brand-sand/20 last:border-0 pr-2"
          >
            <div
              class="font-display text-3xl sm:text-5xl font-bold text-brand-sand"
            >
              320+
            </div>
            <div
              class="text-xs sm:text-sm text-brand-cream/70 uppercase tracking-wider"
            >
              Imóveis Negociados
            </div>
          </div>

          <div
            class="space-y-1 text-center sm:text-left border-r border-brand-sand/20 last:border-0 pr-2"
          >
            <div
              class="font-display text-3xl sm:text-5xl font-bold text-brand-sand"
            >
              98%
            </div>
            <div
              class="text-xs sm:text-sm text-brand-cream/70 uppercase tracking-wider"
            >
              Clientes Satisfeitos
            </div>
          </div>

          <div class="space-y-1 text-center sm:text-left">
            <div
              class="font-display text-3xl sm:text-5xl font-bold text-brand-sand"
            >
              25+
            </div>
            <div
              class="text-xs sm:text-sm text-brand-cream/70 uppercase tracking-wider"
            >
              Prêmios de Excelência
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="imoveis" class="py-12 sm:py-20 bg-brand-cream">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4"
        >
          <div>
            <span
              class="text-xs font-semibold uppercase tracking-widest text-brand-earth"
              >Portfólio Selecionado</span
            >
            <h2
              class="font-display text-3xl sm:text-5xl font-bold text-brand-darkolive uppercase mt-1"
            >
              Imóveis em Destaque
            </h2>
          </div>
          <a
            href="#"
            class="inline-flex items-center gap-2 text-brand-earth hover:text-brand-darkolive font-semibold transition-colors"
          >
            <span>Ver catálogo completo</span>
            <ArrowUpRight class="w-5 h-5" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div
            class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 border border-gray-100 flex flex-col"
          >
            <div class="relative h-64 overflow-hidden">
              <img
                src="https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&q=80&w=1000"
                alt="Residência Horizon"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                width="1000"
                height="667"
                onerror="
                  this.src =
                    'https://placehold.co/1000x667/283618/FEFAE0?text=SWEET+HOME'
                "
                loading="lazy"
                decoding="async"
              />
              <span
                class="absolute top-4 left-4 bg-brand-darkolive/90 backdrop-blur-md text-brand-cream text-xs font-semibold px-3 py-1.5 rounded-full uppercase tracking-wider"
              >
                Venda
              </span>
              <div
                class="absolute bottom-4 left-4 right-4 flex justify-between items-end text-white"
              >
                <span
                  class="font-display text-2xl font-bold text-brand-cream drop-shadow-md"
                  >R$ 4.800.000</span
                >
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <span class="text-xs text-brand-earth font-medium"
                  >Residêncial • Altos do Jardins</span
                >
                <h3
                  class="font-display text-2xl font-semibold text-brand-darkolive mt-1 group-hover:text-brand-sand transition-colors"
                >
                  Residência Horizon
                </h3>
                <p class="text-sm text-gray-600 mt-2 line-clamp-2">
                  Mansão contemporânea com automação total, piscina aquecida e
                  vista panorâmica para a reserva.
                </p>
              </div>
              <div
                class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500 font-medium"
              >
                <span class="flex items-center gap-1"
                  ><Bed class="w-4 h-4" /> 4 Suítes</span
                >
                <span class="flex items-center gap-1"
                  ><Bath class="w-4 h-4" /> 6 Banhos</span
                >
                <span class="flex items-center gap-1"
                  ><Maximize2 class="w-4 h-4" /> 520 m²</span
                >
              </div>
            </div>
          </div>

          <div
            class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 border border-gray-100 flex flex-col"
          >
            <div class="relative h-64 overflow-hidden">
              <img
                src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&q=80&w=1000"
                alt="Edgewood Villa"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                width="1000"
                height="667"
                loading="lazy"
                decoding="async"
              />
              <span
                class="absolute top-4 left-4 bg-brand-sand text-brand-darkolive font-bold text-xs px-3 py-1.5 rounded-full uppercase tracking-wider"
              >
                Destaque
              </span>
              <div
                class="absolute bottom-4 left-4 right-4 flex justify-between items-end text-white"
              >
                <span
                  class="font-display text-2xl font-bold text-brand-cream drop-shadow-md"
                  >R$ 2.950.000</span
                >
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <span class="text-xs text-brand-earth font-medium"
                  >Residêncial • Alphaville</span
                >
                <h3
                  class="font-display text-2xl font-semibold text-brand-darkolive mt-1 group-hover:text-brand-sand transition-colors"
                >
                  Villa Edgewood
                </h3>
                <p class="text-sm text-gray-600 mt-2 line-clamp-2">
                  Design biofílico integrado à natureza, pé direito duplo e
                  espaço gourmet completo.
                </p>
              </div>
              <div
                class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500 font-medium"
              >
                <span class="flex items-center gap-1"
                  ><Bed class="w-4 h-4" /> 3 Suítes</span
                >
                <span class="flex items-center gap-1"
                  ><Bath class="w-4 h-4" /> 4 Banhos</span
                >
                <span class="flex items-center gap-1"
                  ><Maximize2 class="w-4 h-4" /> 380 m²</span
                >
              </div>
            </div>
          </div>

          <div
            class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 border border-gray-100 flex flex-col"
          >
            <div class="relative h-64 overflow-hidden">
              <img
                src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&q=80&w=1000"
                alt="Fazenda Vale das Brisas"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                width="1000"
                height="667"
                loading="lazy"
                decoding="async"
              />
              <span
                class="absolute top-4 left-4 bg-brand-olive text-brand-cream text-xs font-semibold px-3 py-1.5 rounded-full uppercase tracking-wider"
              >
                Rural
              </span>
              <div
                class="absolute bottom-4 left-4 right-4 flex justify-between items-end text-white"
              >
                <span
                  class="font-display text-2xl font-bold text-brand-cream drop-shadow-md"
                  >R$ 12.000.000</span
                >
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <span class="text-xs text-brand-earth font-medium"
                  >Rural • Região do Pantanal</span
                >
                <h3
                  class="font-display text-2xl font-semibold text-brand-darkolive mt-1 group-hover:text-brand-sand transition-colors"
                >
                  Fazenda Vale das Brisas
                </h3>
                <p class="text-sm text-gray-600 mt-2 line-clamp-2">
                  Propriedade rural com estrutura completa para pecuária, sede
                  de luxo e recursos hídricos abundantes.
                </p>
              </div>
              <div
                class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500 font-medium"
              >
                <span class="flex items-center gap-1"
                  ><Trees class="w-4 h-4" /> 450 Hectares</span
                >
                <span class="flex items-center gap-1"
                  ><Home class="w-4 h-4" /> Sede 600m²</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT SECTION (QUEM SOMOS) -->
    <section
      id="quem-somos"
      class="py-20 bg-sh-dark text-sh-cream relative overflow-hidden"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <!-- Left Image Grid -->
          <div class="lg:col-span-6 grid grid-cols-2 gap-4">
            <img
              src="/saladeEstar.avif"
              alt="Interior Luxuoso Sweet Home"
              class="rounded-3xl object-cover h-80 w-full shadow-2xl border border-sh-olive/40 transform -rotate-1 hover:rotate-0 transition-transform duration-500"
              width="600"
              height="800"
              onerror="
                this.src =
                  'https://placehold.co/800x600/283618/FEFAE0?text=SWEET+HOME'
              "
              loading="lazy"
              decoding="async"
            />
            <img
              src="/campoVerdejante.avif"
              alt="Propriedade Rural Sweet Home"
              class="rounded-3xl object-cover h-80 w-full shadow-2xl border border-sh-olive/40 mt-8 transform rotate-1 hover:rotate-0 transition-transform duration-500"
              width="600"
              height="800"
              onerror="
                this.src =
                  'https://placehold.co/800x600/283618/FEFAE0?text=SWEET+HOME'
              "
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Right Content -->
          <div class="lg:col-span-6 space-y-6">
            <span
              class="text-xs font-bold uppercase tracking-widest text-sh-tan"
              >Sobre a Sweet Home</span
            >
            <h2
              class="text-3xl sm:text-5xl font-heading font-bold text-white uppercase leading-tight"
            >
              Tradição em Negócios Imobiliários de Alto Valor
            </h2>
            <p class="text-gray-300 leading-relaxed font-light">
              Fundada com a missão de transformar transações imobiliárias em
              experiências de absoluta confiança, a
              <strong class="text-sh-tan font-semibold">Sweet Home</strong> é referência
              regional em ativos residenciais de alto padrão, fazendas produtivas
              e espaços corporativos de alto desempenho.
            </p>
            <p class="text-gray-300 leading-relaxed font-light">
              Nossa equipe multidisciplinar alia tecnologia de ponta,
              inteligência de mercado e atendimento humanizado para garantir
              segurança jurídica e máxima valorização patrimonial aos nossos
              clientes.
            </p>

            <div
              class="grid grid-cols-2 gap-6 pt-4 border-t border-sh-olive/40"
            >
              <div class="space-y-1">
                <ShieldCheck class="w-8 h-8 text-sh-tan" />
                <h4 class="font-heading font-bold uppercase text-white text-lg">
                  Segurança Jurídica
                </h4>
                <p class="text-xs text-gray-400">
                  Análise minuciosa de toda documentação para transações 100%
                  seguras.
                </p>
              </div>
              <div class="space-y-1">
                <Sparkles class="w-8 h-8 text-sh-tan" />
                <h4 class="font-heading font-bold uppercase text-white text-lg">
                  Curadoria Exclusiva
                </h4>
                <p class="text-xs text-gray-400">
                  Seleção criteriosa dos imóveis mais nobres do mercado.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES SECTION ("End-to-End Solutions") -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-sh-rust"
          >Especialidades Imobiliárias</span
        >
        <h2
          class="text-3xl sm:text-5xl font-heading font-bold text-sh-dark uppercase"
        >
          Soluções Integradas Para Seu Patrimônio
        </h2>
        <p class="text-gray-600 font-light text-base">
          Atendimento sob medida para cada segmento do mercado imobiliário.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Service 1: Residênciais -->
        <div
          class="bg-white rounded-3xl p-8 border border-sh-tan/30 shadow-lg hover:shadow-xl transition-all group hover:-translate-y-1"
        >
          <div
            class="w-14 h-14 bg-sh-cream rounded-2xl flex items-center justify-center text-sh-rust mb-6 border border-sh-tan/40 group-hover:bg-sh-rust group-hover:text-white transition-colors"
          >
            <Building2 class="w-7 h-7" />
          </div>
          <h3
            class="text-2xl font-heading font-bold text-sh-dark uppercase mb-3"
          >
            Imóveis Residênciais
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-6 font-light">
            Apartamentos de alto padrão, penthouses, mansões em condomínios
            fechados e residências nas localizações mais nobres da cidade.
          </p>
          <a
            href="#imoveis"
            onclick="filterCategory('residenciais')"
            class="text-xs font-bold uppercase tracking-wider text-sh-rust hover:text-sh-dark inline-flex items-center gap-2"
          >
            Ver Opções Residênciais
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

        <!-- Service 2: Rurais -->
        <div
          class="bg-white rounded-3xl p-8 border border-sh-tan/30 shadow-lg hover:shadow-xl transition-all group hover:-translate-y-1"
        >
          <div
            class="w-14 h-14 bg-sh-cream rounded-2xl flex items-center justify-center text-sh-olive mb-6 border border-sh-tan/40 group-hover:bg-sh-olive group-hover:text-white transition-colors"
          >
            <Trees class="w-7 h-7" />
          </div>
          <h3
            class="text-2xl font-heading font-bold text-sh-dark uppercase mb-3"
          >
            Imóveis Rurais
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-6 font-light">
            Fazendas para pecuária e lavoura, sítios de recreio, haras e áreas
            com aptidão agrícola com georreferenciamento atualizado.
          </p>
          <a
            href="#imoveis"
            onclick="filterCategory('rurais')"
            class="text-xs font-bold uppercase tracking-wider text-sh-olive hover:text-sh-dark inline-flex items-center gap-2"
          >
            Ver Opções Rurais <ArrowRight class="w-4 h-4" />
          </a>
        </div>

        <!-- Service 3: Comerciais -->
        <div
          class="bg-white rounded-3xl p-8 border border-sh-tan/30 shadow-lg hover:shadow-xl transition-all group hover:-translate-y-1"
        >
          <div
            class="w-14 h-14 bg-sh-cream rounded-2xl flex items-center justify-center text-sh-dark mb-6 border border-sh-tan/40 group-hover:bg-sh-dark group-hover:text-white transition-colors"
          >
            <Briefcase class="w-7 h-7" />
          </div>
          <h3
            class="text-2xl font-heading font-bold text-sh-dark uppercase mb-3"
          >
            Ativos Comerciais
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-6 font-light">
            Salas corporativas, lajes inteiras, galpões logísticos e terrenos
            estratégicos para expansão de empreendimentos.
          </p>
          <a
            href="#imoveis"
            onclick="filterCategory('comerciais')"
            class="text-xs font-bold uppercase tracking-wider text-sh-dark hover:text-sh-rust inline-flex items-center gap-2"
          >
            Ver Opções Comerciais
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- Soluções da Sweet Home -->
    <section
      id="solucoes"
      class="py-16 sm:py-24 bg-brand-darkolive text-brand-cream"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
          <span
            class="text-xs font-semibold uppercase tracking-widest text-brand-sand"
            >Soluções Ponta a Ponta</span
          >
          <h2 class="font-display text-3xl sm:text-5xl font-bold uppercase">
            Por que escolher a Sweet Home
          </h2>
          <p class="text-brand-cream/80 text-sm sm:text-base font-light">
            Combinamos a expertise em arquitetura com inteligência imobiliária
            para entregar transações seguras e transparentes.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div
            class="p-8 rounded-2xl bg-brand-olive/20 border border-brand-sand/10 hover:border-brand-sand/40 transition-all space-y-4"
          >
            <div
