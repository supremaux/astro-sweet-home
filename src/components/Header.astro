---
import { ChevronDown, Menu, Phone } from "@lucide/astro";
import Logo from "./Logo.astro";
---

<header
    class="fixed top-0 left-0 right-0 z-50 bg-brand-darkolive/95 backdrop-blur-md border-b border-brand-sand/20 transition-all duration-300"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <Logo
            width={150}
            height={50}
            loading="lazy"
            decoding="async"
            priority="low"
          />
        </a>

        <nav class="hidden lg:flex items-center gap-8">
          <a
            href="/"
            class="font-display text-lg tracking-wider text-brand-cream hover:text-brand-sand transition-colors duration-200"
            >Home</a
          >
          <a
            href="/quem-somos"
            class="font-display text-lg tracking-wider text-brand-cream hover:text-brand-sand transition-colors duration-200"
            >Quem Somos</a
          >

          <div class="relative group">
            <button
              class="font-display text-lg tracking-wider text-brand-cream hover:text-brand-sand transition-colors duration-200 flex items-center gap-1 py-2"
            >
              Imóveis
              <ChevronDown class="w-4 h-4" />
            </button>
            <div
              class="absolute top-full left-0 w-48 bg-brand-darkolive border border-brand-sand/20 rounded-b-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2"
            >
              <a
                href="/residencial"
                class="block px-4 py-2 text-sm text-brand-cream hover:bg-brand-olive/40 hover:text-brand-sand"
                >Residênciais</a
              >
              <a
                href="/rurais"
                class="block px-4 py-2 text-sm text-brand-cream hover:bg-brand-olive/40 hover:text-brand-sand"
                >Rurais</a
              >
              <a
                href="/comerciais"
                class="block px-4 py-2 text-sm text-brand-cream hover:bg-brand-olive/40 hover:text-brand-sand"
                >Comerciais</a
              >
            </div>
          </div>

          <a
            href="#unidades"
            class="font-display text-lg tracking-wider text-brand-cream hover:text-brand-sand transition-colors duration-200"
            >Unidades</a
          >
          <a
            href="#contato"
            class="font-display text-lg tracking-wider text-brand-cream hover:text-brand-sand transition-colors duration-200"
            >Contato</a
          >
        </nav>

        <div class="hidden lg:flex items-center">
          <a
            href="#contato"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-brand-sand hover:bg-brand-earth text-brand-darkolive hover:text-white font-medium transition-all duration-300 shadow-md"
          >
            <Phone class="w-5 h-5" />
            <span>Fale Conosco</span>
          </a>
        </div>

        <div class="lg:hidden flex items-center">
          <button
            id="mobile-menu-btn"
            type="button"
            class="p-2 rounded-lg text-brand-cream hover:text-brand-sand focus:outline-none"
            aria-label="Abrir menu"
          >
            <Menu class="w-7 h-7" />
          </button>
        </div>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="hidden lg:hidden bg-brand-darkolive border-b border-brand-sand/20 px-4 pt-2 pb-6 space-y-3"
    >
      <a
        href="/"
        class="block px-3 py-2 rounded-md font-display text-xl text-brand-cream hover:bg-brand-olive/30 hover:text-brand-sand"
        >Home</a
      >
      <a
        href="/quem-somos"
        class="block px-3 py-2 rounded-md font-display text-xl text-brand-cream hover:bg-brand-olive/30 hover:text-brand-sand"
        >Quem Somos</a
      >

      <div class="space-y-1 pl-3 border-l-2 border-brand-sand/30 my-2">
        <span
          class="block px-3 py-1 font-display text-sm tracking-wider text-brand-sand uppercase"
          >Imóveis</span
        >
        <a
          href="/residenciais"
          class="block px-3 py-1.5 text-brand-cream/80 hover:text-brand-sand text-base"
          >Residenciais</a
        >
        <a
          href="/rurais"
          class="block px-3 py-1.5 text-brand-cream/80 hover:text-brand-sand text-base"
          >Rurais</a
        >
        <a
          href="/comerciais"
          class="block px-3 py-1.5 text-brand-cream/80 hover:text-brand-sand text-base"
          >Comerciais</a
        >
      </div>

      <a
        href="/unidades"
        class="block px-3 py-2 rounded-md font-display text-xl text-brand-cream hover:bg-brand-olive/30 hover:text-brand-sand"
        >Unidades</a
      >
      <a
        href="/contato"
        class="block px-3 py-2 rounded-md font-display text-xl text-brand-cream hover:bg-brand-olive/30 hover:text-brand-sand"
        >Contato</a
      >

      <a
        href="/contato"
        class="w-full mt-4 flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-brand-sand text-brand-darkolive font-medium text-center"
      >
        <i data-lucide="phone" class="w-5 h-5"></i>
        <span>Fale Conosco</span>
      </a>
    </div>
  </header>
